# Visitor stats from the App-UTP Supabase project (public_stats).
# Leave empty and the stats blocks simply do not render.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Kolong Run first-visit popup on the homepage. Only the exact value "true" turns it on.
# The /kolong-run/ routes are always built and do not read this flag.
PUBLIC_KOLONG_POPUP=
