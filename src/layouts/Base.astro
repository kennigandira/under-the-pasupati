---
import "../styles/global.css";
import { languages, localeHref, t, type Lang } from "../i18n/ui";

interface Props {
    lang: Lang;
    title?: string;
    description?: string;
    path: string; // path after /:lang, e.g. '/journal' — used for the language switcher
    type?: "website" | "article";
    image?: string; // absolute path or URL; defaults to the generated site card
    imageAlt?: string;
    publishedTime?: string; // ISO date, article only
    author?: string; // article only
    section?: string; // article only
    jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
    lang,
    title,
    description,
    path,
    type = "website",
    image,
    imageAlt,
    publishedTime,
    author,
    section,
    jsonLd,
} = Astro.props;
const pageTitle = title
    ? `${title} — ${t(lang, "site.title")}`
    : t(lang, "site.title");
const desc = description ?? t(lang, "site.tagline");
const other: Lang = lang === "id" ? "en" : "id";

const origin = (Astro.site ?? Astro.url).origin;
const canonical = new URL(localeHref(lang, path), origin).href;
const ogImage = new URL(image ?? `/og/site-${lang}.png`, origin).href;
// 1200×630 for both the generated article cards and the site card.
const ogImageWidth = 1200;
const ogImageHeight = 630;
const ogLocale = lang === "id" ? "id_ID" : "en_US";
const ogLocaleAlt = other === "id" ? "id_ID" : "en_US";

const nav = [
    ["nav.home", ""],
    ["nav.park", "/the-park"],
    ["nav.hof", "/hall-of-fame"],
    ["nav.journal", "/journal"],
    ["nav.partners", "/partners"],
    ["nav.events", "/events"],
    ["nav.about", "/about"],
] as const;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle}</title>
        <meta name="description" content={desc} />
        <link rel="canonical" href={canonical} />
        <meta name="theme-color" content="#f4efe2" />

        <meta property="og:site_name" content={t(lang, "site.title")} />
        <meta property="og:type" content={type} />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={desc} />
        <meta property="og:locale" content={ogLocale} />
        <meta property="og:locale:alternate" content={ogLocaleAlt} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content={String(ogImageWidth)} />
        <meta property="og:image:height" content={String(ogImageHeight)} />
        <meta property="og:image:alt" content={imageAlt ?? pageTitle} />
        {type === "article" && publishedTime && (
            <meta
                property="article:published_time"
                content={publishedTime}
            />
        )}
        {type === "article" && author && (
            <meta property="article:author" content={author} />
        )}
        {type === "article" && section && (
            <meta property="article:section" content={section} />
        )}

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={desc} />
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:image:alt" content={imageAlt ?? pageTitle} />

        {languages.map((l) => (
            <link rel="alternate" hreflang={l} href={new URL(localeHref(l, path), origin).href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={new URL(localeHref("id", path), origin).href} />
        {jsonLd && (
            <script
                type="application/ld+json"
                set:html={JSON.stringify(jsonLd)}
            />
        )}
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Anton&family=Bungee&family=Space+Grotesk:wght@400;700&family=Space+Mono:wght@400;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <header class="site-header">
            <div class="wrap">
                <a class="brand" href={localeHref(lang, "")}>
                    Under the Pasupati
                </a>
                <nav aria-label="Main">
                    <ul class="nav-list">
                        {nav.map(([key, href]) => (
                            <li>
                                <a
                                    href={localeHref(lang, href)}
                                    aria-current={
                                        path === href ? "page" : undefined
                                    }
                                >
                                    {t(lang, key)}
                                </a>
                            </li>
                        ))}
                        <li>
                            <a
                                class="lang-switch"
                                href={localeHref(other, path)}
                                hreflang={other}
                                lang={other}
                            >
                                {t(lang, "lang.switch")}
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </header>
        <main>
            <slot />
        </main>
        <footer class="site-footer">
            <div class="wrap">
                <p class="foot-mark">Under the Pasupati</p>
                <p>{t(lang, "about.disclaimer")}</p>
            </div>
        </footer>
    </body>
</html>
