---
import Base from "../../layouts/Base.astro";
import MediaSlot from "../../components/MediaSlot.astro";
import JournalCard from "../../components/JournalCard.astro";
import PartnerChip from "../../components/PartnerChip.astro";
import SpecialtyLink from "../../components/SpecialtyLink.astro";
import SpecialtyVideoDialog from "../../components/SpecialtyVideoDialog.astro";
import { languages, localeHref, t, type Lang } from "../../i18n/ui";
import {
    skaters,
    posts,
    conditionEntries,
    usageSnapshot,
    aboutSlides,
    lessonProviders,
    boardRental,
    partners,
    faqs,
} from "../../data/content";
import { contactHref, contactLabel } from "../../lib/contacts";
import { withBuddyTip } from "../../lib/terms";
import { years } from "../../lib/format";

export function getStaticPaths() {
    return languages.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const partnerBySlug = (slug?: string) => partners.find((p) => p.slug === slug);
const rentalPartner = partnerBySlug(boardRental.partner);

const featured = [...skaters].sort((a, b) =>
    b.featuredFrom.localeCompare(a.featuredFrom),
)[0];
const latest = [...posts]
    .sort((a, b) => b.date.localeCompare(a.date))
    .slice(0, 3);
---

<Base lang={lang} path="">
    <!-- 1. Hero -->
    <section class="hero">
        <div class="wrap hero-inner">
            <span class="burst">
                Est.
                <br />
                2026
            </span>
            <svg
                class="scribble"
                style="bottom: -10px; left: 55%;"
                width="90"
                height="110"
                viewBox="0 0 90 110"
                aria-hidden="true"
            >
                <path d="M45 5 C 20 30, 75 45, 50 70 C 35 85, 30 88, 38 98 M28 90 L 38 100 L 48 92" />
            </svg>
            <h1 class="hero-title">
                <span class="line l1">
                    {lang === "id" ? "Di Bawah" : "Under"}
                </span>
                {lang === "en" && <span class="line l2">— the —</span>}
                <span class="line l3">Pasupati</span>
            </h1>
            <p class="hero-tag">{t(lang, "site.tagline")}</p>
            <MediaSlot
                lang={lang}
                slot={{
                    kind: "video",
                    hint: {
                        id: t(lang, "home.hero.alt"),
                        en: t("en", "home.hero.alt"),
                    },
                }}
            />
        </div>
    </section>

    <!-- 2. About this site: carousel + excerpt -->
    <section class="section">
        <div class="wrap">
            <div class="section-head">
                <h2>{t(lang, "home.about.title")}</h2>
            </div>
            <div class="grid grid-2" style="align-items: start;">
                <div
                    class="carousel"
                    role="group"
                    aria-label={t(lang, "home.about.title")}
                >
                    {aboutSlides.map((slide, i) => (
                        <figure class="slide">
                            <span class="slide-index">
                                {String(i + 1).padStart(2, "0")} /{" "}
                                {String(aboutSlides.length).padStart(2, "0")}
                            </span>
                            <MediaSlot lang={lang} slot={slide} />
                        </figure>
                    ))}
                </div>
                <div>
                    <p style="font-size: 1.05rem;">
                        {t(lang, "home.about.body")}
                    </p>
                    <p style="margin-top: 1rem; font-size: 1.05rem;">
                        {t(lang, "home.about.ownership")}
                    </p>
                    <p style="margin-top: 1.25rem;">
                        <a class="btn" href={localeHref(lang, "/the-park")}>
                            {t(lang, "home.about.cta")} →
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. Skater of the month -->
    <section class="section">
        <div class="wrap grid grid-2" style="align-items: start;">
            <div>
                <div class="section-head">
                    <h2>{t(lang, "home.featured")}</h2>
                    <a class="mono" href={localeHref(lang, "/hall-of-fame")}>
                        {t(lang, "see.all")} →
                    </a>
                </div>
                <article class="card card-accent">
                    <MediaSlot
                        lang={lang}
                        slot={featured.portrait}
                        variant="portrait"
                    />
                    <h3 style="margin-top: 0.75rem;">
                        {featured.alias
                            ? `${featured.name} “${featured.alias}”`
                            : featured.name}
                    </h3>
                    <p class="meta">
                        <span>{featured.crew}</span>
                        <span>{featured.discipline}</span>
                        <span>
                            {t(lang, "hof.years")}: {years(featured.yearsSkating, lang)}
                        </span>
                    </p>
                    <p>{featured.bio[lang]}</p>
                    <a
                        class="mono"
                        href={localeHref(
                            lang,
                            `/hall-of-fame/${featured.slug}`,
                        )}
                    >
                        {t(lang, "read.more")} →
                    </a>
                </article>
            </div>

            <!-- 4. Park condition -->
            <div>
                <div class="section-head">
                    <h2>{t(lang, "home.status")}</h2>
                    <a class="mono" href={localeHref(lang, "/the-park")}>
                        {t(lang, "see.all")} →
                    </a>
                </div>
                <div class="stats" style="margin-bottom: 1.25rem;">
                    <div class="stat">
                        <div class="num">{usageSnapshot.avgPerDay}</div>
                        <div class="mono">
                            {lang === "id" ? "skater / hari" : "skaters / day"}
                        </div>
                    </div>
                    <div class="stat">
                        <div
                            class="num"
                            style="font-size: 1.1rem; padding-top: 0.5rem;"
                        >
                            {usageSnapshot.peakHours[lang]}
                        </div>
                        <div class="mono">
                            {lang === "id" ? "jam ramai" : "peak hours"}
                        </div>
                    </div>
                </div>
                <div class="ledger">
                    <div class="ledger-head">
                        <span>{lang === "id" ? "Tgl" : "Date"}</span>
                        <span>{lang === "id" ? "Lokasi" : "Spot"}</span>
                        <span>Status</span>
                    </div>
                    {conditionEntries.map((c) => (
                        <div class="ledger-row">
                            <span class="ledger-date">
                                {c.date.slice(8)}.{c.date.slice(5, 7)}
                            </span>
                            <div>
                                <span class="ledger-spot">{c.spot[lang]}</span>
                                <p style="font-size: 0.85rem; margin-top: 0.15rem;">
                                    {c.note[lang]}
                                </p>
                            </div>
                            <span
                                class={`badge badge-${c.severity} ledger-badge`}
                            >
                                {t(lang, `condition.${c.severity}` as any)}
                            </span>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <!-- 5. Journal -->
    <section class="section">
        <div class="wrap">
            <div class="section-head">
                <h2>{t(lang, "home.latest")}</h2>
                <a class="mono" href={localeHref(lang, "/journal")}>
                    {t(lang, "see.all")} →
                </a>
            </div>
            <div class="grid grid-3">
                {latest.map((p) => (
                    <JournalCard post={p} lang={lang} />
                ))}
            </div>
        </div>
    </section>

    <!-- 6. Skateboard instructors -->
    <section class="section" id="pengajar">
        <div class="wrap">
            <div class="section-head">
                <h2>{t(lang, "home.lessons.title")}</h2>
                <a class="mono" href={localeHref(lang, "/about")}>
                    {t(lang, "home.lessons.cta")} →
                </a>
            </div>
            <p style="max-width: 60ch; margin-bottom: 1.5rem;">
                {t(lang, "home.lessons.body")}
            </p>

            <div class="rental-callout">
                <div>
                    <span class="stamp">{boardRental.label[lang]}</span>
                    <h3
                        style="margin-top: 0.6rem;"
                        set:html={withBuddyTip(
                            boardRental.title[lang],
                            boardRental.buddyTip[lang],
                        )}
                    />
                    <p
                        style="margin-top: 0.4rem;"
                        set:html={withBuddyTip(
                            boardRental.body[lang],
                            boardRental.buddyTip[lang],
                        )}
                    />
                    <ul class="rental-rates">
                        {boardRental.rates.map((r) => (
                            <li>
                                <span
                                    set:html={withBuddyTip(
                                        r.label[lang],
                                        boardRental.buddyTip[lang],
                                    )}
                                />
                                <span class="mono">{r.price[lang]}</span>
                            </li>
                        ))}
                    </ul>
                    <p class="mono" style="margin-top: 0.4rem;">
                        {boardRental.underFifteen[lang]}
                    </p>
                    <p class="mono" style="margin-top: 0.5rem;">
                        {boardRental.note[lang]}
                    </p>
                </div>
                <div class="rental-right">
                    <p>
                        <a class="btn" href={localeHref(lang, "/about")}>
                            {boardRental.cta[lang]} →
                        </a>
                    </p>
                </div>
                <div class="rental-partner">
                    <PartnerChip
                        partner={rentalPartner}
                        lang={lang}
                        label={t(lang, "partners.by")}
                        variant="lockup"
                    />
                </div>
            </div>
            <div class="grid grid-3">
                {lessonProviders.map((p) => (
                    <article class="card coach-card">
                        <MediaSlot lang={lang} slot={p.portrait} />
                        <h3 style="margin-top: 0.75rem;">{p.name}</h3>
                        <PartnerChip partner={partnerBySlug(p.partner)} lang={lang} />
                        <dl class="coach-facts">
                            <div>
                                <dt>{t(lang, "coach.level")}</dt>
                                <dd>{p.levels[lang]}</dd>
                            </div>
                            {p.specialties?.length && (
                                <div>
                                    <dt>{t(lang, "coach.specialty")}</dt>
                                    <dd class="specialty-list">
                                        {p.specialties.map((s, i) => (
                                            <>
                                                {i > 0 && <span class="specialty-sep" aria-hidden="true">·</span>}
                                                <SpecialtyLink
                                                    lang={lang}
                                                    label={s.label}
                                                    videoKey={s.video}
                                                />
                                            </>
                                        ))}
                                    </dd>
                                </div>
                            )}
                            {p.age !== undefined && (
                                <div>
                                    <dt>{t(lang, "coach.age")}</dt>
                                    <dd>{years(p.age, lang)}</dd>
                                </div>
                            )}
                            {p.yearsSkating !== undefined && (
                                <div>
                                    <dt>{t(lang, "hof.years")}</dt>
                                    <dd>{years(p.yearsSkating, lang)}</dd>
                                </div>
                            )}
                            {p.competition && (
                                <div>
                                    <dt>{t(lang, "coach.competition")}</dt>
                                    <dd>{p.competition[lang]}</dd>
                                </div>
                            )}
                        </dl>
                        {p.rate && (
                            <p class="mono" style="margin-top: 0.35rem;">
                                {p.rate[lang]}
                            </p>
                        )}
                        <p style="margin-top: 0.85rem; display: flex; flex-wrap: wrap; gap: 0.4rem;">
                            {p.contacts.map((c) => (
                                <a
                                    class="contact-pill"
                                    href={contactHref(c)}
                                    rel="noopener noreferrer"
                                >
                                    {contactLabel(c.kind)} ↗
                                </a>
                            ))}
                        </p>
                        <p style="margin-top: 0.6rem;">
                            <a
                                class="mono"
                                href={localeHref(lang, `/coaches/${p.slug}`)}
                            >
                                {t(lang, "coach.viewProfile")} →
                            </a>
                        </p>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <!-- 7. FAQ -->
    <section class="section">
        <div class="wrap" style="max-width: 820px; margin-inline: auto;">
            <div class="section-head">
                <h2>{t(lang, "home.faq.title")}</h2>
            </div>
            <div class="faq-list">
                {faqs.map((f) => (
                    <details class="faq">
                        <summary
                            set:html={withBuddyTip(
                                f.q[lang],
                                boardRental.buddyTip[lang],
                            )}
                        />
                        <p
                            set:html={withBuddyTip(
                                f.a[lang],
                                boardRental.buddyTip[lang],
                            )}
                        />
                    </details>
                ))}
            </div>
        </div>
    </section>
    <SpecialtyVideoDialog lang={lang} />
</Base>
