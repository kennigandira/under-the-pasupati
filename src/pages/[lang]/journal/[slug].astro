---
import Base from '../../../layouts/Base.astro';
import MediaSlot from '../../../components/MediaSlot.astro';
import ShareBar from '../../../components/ShareBar.astro';
import { languages, localeHref, t, type Lang } from '../../../i18n/ui';
import { posts } from '../../../data/content';
import { plainInline, renderInline } from '../../../lib/inline';

export function getStaticPaths() {
  return languages.flatMap((lang) => posts.map((p) => ({ params: { lang, slug: p.slug } })));
}
const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const p = posts.find((x) => x.slug === slug)!;
const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString(lang === 'id' ? 'id-ID' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const origin = (Astro.site ?? Astro.url).origin;
const canonical = new URL(localeHref(lang, `/journal/${slug}`), origin).href;
const ogImage = new URL(`/og/${lang}/${slug}.png`, origin).href;
const storyImage = `/og/story/${lang}/${slug}.png`;
const postPath = `/journal/${slug}`;
const title = plainInline(p.title[lang]);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description: p.excerpt[lang],
    image: [ogImage],
    datePublished: p.date,
    dateModified: p.date,
    inLanguage: lang === 'id' ? 'id-ID' : 'en',
    author: { '@type': 'Person', name: p.author },
    publisher: {
      '@type': 'Organization',
      name: t(lang, 'site.title'),
      url: new URL(localeHref(lang, ''), origin).href,
    },
    mainEntityOfPage: canonical,
    isAccessibleForFree: true,
    articleSection: p.category,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: t(lang, 'nav.home'),
        item: new URL(localeHref(lang, ''), origin).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: t(lang, 'journal.title'),
        item: new URL(localeHref(lang, '/journal'), origin).href,
      },
      { '@type': 'ListItem', position: 3, name: title, item: canonical },
    ],
  },
];
---

<Base
  lang={lang}
  title={title}
  description={p.excerpt[lang]}
  path={postPath}
  type="article"
  image={ogImage}
  imageAlt={p.cover.hint[lang]}
  publishedTime={p.date}
  author={p.author}
  section={p.category}
  jsonLd={jsonLd}
>
  <article class="section">
    <div class="wrap" style="max-width: 720px;">
      <a class="mono" href={localeHref(lang, '/journal')}>← {t(lang, 'journal.title')}</a>
      <h1 style="margin: 1rem 0 0.5rem;" set:html={renderInline(p.title[lang])} />
      <p class="meta"><span>{fmt(p.date)}</span><span>{p.category}</span></p>
      {lang === 'en' && (
        <p class="translation-note">{t(lang, 'post.translationNotice')}</p>
      )}
      <div class="tape" style="margin: 2rem 0;">
        <MediaSlot lang={lang} slot={p.cover} class="journal-photo" />
      </div>
      {p.body[lang].split('\n\n').map((para, i) => (
        <>
          <p style="margin-bottom: 1.25rem; font-size: 1.05rem;" set:html={renderInline(para)} />
          {p.inline?.filter((m) => m.afterParagraph === i + 1).map((m) => (
            <figure class="tape" style="margin: 2.25rem 0;">
              <MediaSlot lang={lang} slot={m.slot} class="journal-photo" />
            </figure>
          ))}
        </>
      ))}
      <p class="post-author">{t(lang, 'post.writtenBy')} <strong>{p.author}</strong></p>
      <ShareBar url={canonical} title={title} lang={lang} story={storyImage} slug={slug} />
    </div>
  </article>
</Base>
