---
import Base from '../../../layouts/Base.astro';
import JournalCard from '../../../components/JournalCard.astro';
import { languages, t, type Lang } from '../../../i18n/ui';
import { posts } from '../../../data/content';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const sorted = [...posts].sort((a, b) => b.date.localeCompare(a.date));
---

<Base lang={lang} title={t(lang, 'journal.title')} path="/journal">
  <section class="section">
    <div class="wrap">
      <h1>{t(lang, 'journal.title')}</h1>
      <div class="grid grid-3" style="margin-top: 2rem;">
        {sorted.map((p) => <JournalCard post={p} lang={lang} />)}
      </div>
    </div>
  </section>
</Base>
