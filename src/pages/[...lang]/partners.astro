---
import Base from '../../layouts/Base.astro';
import MediaSlot from '../../components/MediaSlot.astro';
import { localeRoutes, routeLang, t } from '../../i18n/ui';
import { partners } from '../../data/content';

export function getStaticPaths() {
  return localeRoutes();
}
const lang = routeLang(Astro.params.lang);
---

<Base lang={lang} title={t(lang, 'partners.title')} path="/partners">
  <section class="section">
    <div class="wrap">
      <h1>{t(lang, 'partners.title')}</h1>
      <div class="grid grid-3" style="margin-top: 2rem;">
        {partners.map((c) => (
          <article class="card" style="text-align: center;">
            <MediaSlot lang={lang} slot={c.logo} link={c.link} />
            <h3 style="margin-top: 0.75rem;">{c.name}</h3>
            <p>{c.intro[lang]}</p>
            {c.link && (
              <a class="mono" href={c.link} rel="noopener noreferrer">
                {new URL(c.link).hostname.replace('www.', '')} ↗
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
