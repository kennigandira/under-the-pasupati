---
import Base from '../../../layouts/Base.astro';
import MediaSlot from '../../../components/MediaSlot.astro';
import { localeHref, localeRoutes, routeLang, t } from '../../../i18n/ui';
import { skaters } from '../../../data/content';
import { years } from '../../../lib/format';

export function getStaticPaths() {
  return localeRoutes().flatMap(({ params }) =>
    skaters.map((s) => ({ params: { ...params, slug: s.slug } })),
  );
}
const { slug } = Astro.params as { slug: string };
const lang = routeLang(Astro.params.lang);
const s = skaters.find((x) => x.slug === slug)!;
const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString(lang === 'id' ? 'id-ID' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base lang={lang} title={s.name} description={s.bio[lang]} path={`/hall-of-fame/${slug}`}>
  <section class="section">
    <div class="wrap">
      <a class="mono" href={localeHref(lang, '/hall-of-fame')}>← {t(lang, 'hof.title')}</a>
      <h1 style="margin: 1rem 0 0.25rem;">{s.alias ? `${s.name} “${s.alias}”` : s.name}</h1>
      <p class="meta">
        <span>{t(lang, 'hof.crew')}: {s.crew}</span>
        <span>{t(lang, 'hof.discipline')}: {s.discipline}</span>
        <span>{t(lang, 'hof.years')}: {years(s.yearsSkating, lang)}</span>
        <span>{t(lang, 'home.featured')}: {fmt(s.featuredFrom)}</span>
      </p>
      <div class="grid grid-2" style="margin-top: 2rem; align-items: start;">
        <MediaSlot lang={lang} slot={s.portrait} variant="portrait" class="tape" />
        <div>
          <h2>{lang === 'id' ? 'Tentang' : 'About'}</h2>
          <p style="margin: 0.75rem 0 1.5rem;">{s.bio[lang]}</p>
          <h3>{lang === 'id' ? 'Spot & trik favorit' : 'Favorite spots & tricks'}</h3>
          <p style="margin: 0.5rem 0 1.5rem;">{s.favorites[lang]}</p>
          <MediaSlot lang={lang} slot={s.clip} />
        </div>
      </div>
    </div>
  </section>
</Base>
