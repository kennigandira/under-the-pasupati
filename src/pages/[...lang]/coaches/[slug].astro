---
import Base from '../../../layouts/Base.astro';
import CoachMedia from '../../../components/CoachMedia.astro';
import PartnerChip from '../../../components/PartnerChip.astro';
import SpecialtyLink from '../../../components/SpecialtyLink.astro';
import SpecialtyVideoDialog from '../../../components/SpecialtyVideoDialog.astro';
import { localeHref, localeRoutes, routeLang, t } from '../../../i18n/ui';
import { lessonProviders, partners } from '../../../data/content';
import { contactHref, contactLabel } from '../../../lib/contacts';
import { years, coachSummary } from '../../../lib/format';

export function getStaticPaths() {
  return localeRoutes().flatMap(({ params }) =>
    lessonProviders.map((p) => ({ params: { ...params, slug: p.slug } })),
  );
}
const { slug } = Astro.params as { slug: string };
const lang = routeLang(Astro.params.lang);
const coach = lessonProviders.find((p) => p.slug === slug)!;
const partnerBySlug = (slug?: string) => partners.find((p) => p.slug === slug);
const specialtyLabel = coach.specialties?.map((s) => s.label[lang]).join(' & ');
const description = coachSummary(specialtyLabel, coach.levels[lang], lang);
---

<Base lang={lang} title={coach.name} description={description} path={`/coaches/${slug}`}>
  <section class="section">
    <div class="wrap">
      <a class="mono" href={`${localeHref(lang, '')}#pengajar`}>← {t(lang, 'home.lessons.title')}</a>

      <div class="coach-header" style="margin-top: 1.5rem;">
        <div>
          <PartnerChip partner={partnerBySlug(coach.partner)} lang={lang} />
          <h1 style="margin: 0.75rem 0 0.5rem;">{coach.name}</h1>
        </div>

        <div>
          <dl class="coach-facts">
            <div>
              <dt>{t(lang, 'coach.level')}</dt>
              <dd>{coach.levels[lang]}</dd>
            </div>
            {coach.specialties?.length && (
              <div>
                <dt>{t(lang, 'coach.specialty')}</dt>
                <dd class="specialty-list">
                  {coach.specialties.map((s, i) => (
                    <>
                      {i > 0 && <span class="specialty-sep" aria-hidden="true">·</span>}
                      <SpecialtyLink lang={lang} label={s.label} videoKey={s.video} />
                    </>
                  ))}
                </dd>
              </div>
            )}
            {coach.age !== undefined && (
              <div>
                <dt>{t(lang, 'coach.age')}</dt>
                <dd>{years(coach.age, lang)}</dd>
              </div>
            )}
            {coach.yearsSkating !== undefined && (
              <div>
                <dt>{t(lang, 'skater.years')}</dt>
                <dd>{years(coach.yearsSkating, lang)}</dd>
              </div>
            )}
            {coach.competition && (
              <div>
                <dt>{t(lang, 'coach.competition')}</dt>
                <dd>{coach.competition[lang]}</dd>
              </div>
            )}
            {coach.rate && (
              <div>
                <dt>{lang === 'id' ? 'Tarif' : 'Rate'}</dt>
                <dd>{coach.rate[lang]}</dd>
              </div>
            )}
          </dl>

          <p style="margin: 1rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem;">
            {coach.contacts.map((c) => (
              <a class="contact-pill" href={contactHref(c)} rel="noopener noreferrer">
                {contactLabel(c.kind)} ↗
              </a>
            ))}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <CoachMedia
        lang={lang}
        items={[
          { slot: coach.portrait, label: t(lang, 'coach.media.photo') },
          {
            slot: coach.trainingVideo,
            label: t(lang, 'coach.media.teaching'),
            tag: t(lang, 'coach.media.teaching.tape'),
          },
          {
            slot: coach.trickVideo,
            label: t(lang, 'coach.media.riding'),
            tag: t(lang, 'coach.media.riding.tape'),
          },
        ]}
      />
    </div>
  </section>
  <SpecialtyVideoDialog lang={lang} />
</Base>
