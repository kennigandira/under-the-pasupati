---
import { localeHref, t, type Lang } from '../i18n/ui';

// First-visit homepage popup for Kolong Run. Rendered only when the
// PUBLIC_KOLONG_POPUP flag is on (see index.astro). Style and script are
// inline so nothing from this component ships when the flag is off.
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const src = localeHref(lang, '/kolong-run/embed');
---

<dialog class="kolong-dialog" data-kolong-dialog data-src={src} aria-label={t(lang, 'game.popup.title')}>
  <div class="kolong-dialog-bar">
    <span class="kolong-dialog-title" aria-hidden="true">{t(lang, 'game.popup.title')}</span>
    <button class="kolong-dialog-close" type="button" aria-label={t(lang, 'media.close')}>×</button>
  </div>
  <div class="kolong-dialog-frame" data-frame></div>
</dialog>

<style is:inline>
  .kolong-dialog {
    padding: 0;
    border: 3px solid var(--ink);
    background: var(--paper);
    width: min(96vw, 560px);
    height: min(92dvh, 780px);
    max-width: 100vw;
    max-height: 100dvh;
    overflow: hidden;
    margin: auto;
  }
  .kolong-dialog[open] { display: flex; flex-direction: column; }
  .kolong-dialog::backdrop { background: rgba(16, 16, 16, 0.55); backdrop-filter: blur(6px); }
  .kolong-dialog-bar {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.35rem 0.5rem 0.35rem 0.9rem;
    border-bottom: 3px solid var(--ink);
    background: var(--tape);
  }
  .kolong-dialog-title { font-family: var(--font-logo); font-size: 0.95rem; text-transform: uppercase; }
  .kolong-dialog-close {
    width: 44px;
    height: 44px;
    border: 3px solid var(--ink);
    background: var(--white);
    font-size: 1.7rem;
    line-height: 1;
    cursor: pointer;
  }
  .kolong-dialog-close:focus-visible { outline: 3px solid var(--pink); outline-offset: 2px; }
  .kolong-dialog-frame { flex: 1; min-height: 0; }
  .kolong-dialog-iframe { display: block; width: 100%; height: 100%; border: 0; }
  @media (max-width: 600px) {
    .kolong-dialog { width: 100vw; height: 100dvh; border: 0; }
  }
</style>

<script is:inline>
  (function () {
    var KEY = 'kolong:seen';
    var dlg = document.querySelector('[data-kolong-dialog]');
    if (!dlg) return;
    try {
      if (localStorage.getItem(KEY)) return;
    } catch (e) {
      return;
    }
    var holder = dlg.querySelector('[data-frame]');
    var frame = null;

    function cleanup() {
      document.documentElement.classList.remove('lightbox-open');
      if (frame) {
        frame.remove();
        frame = null;
      }
    }

    dlg.querySelector('.kolong-dialog-close').addEventListener('click', function () {
      dlg.close();
    });
    dlg.addEventListener('click', function (e) {
      if (e.target === dlg) dlg.close();
    });
    dlg.addEventListener('close', cleanup);
    window.addEventListener('message', function (e) {
      if (e.origin !== location.origin || !frame) return;
      if (e.source !== frame.contentWindow) return;
      if (e.data && e.data.type === 'kolong:close') dlg.close();
    });

    function open() {
      if (document.visibilityState !== 'visible') return;
      if (document.querySelector('dialog[open]')) return;
      try {
        localStorage.setItem(KEY, '1');
      } catch (e) {
        return;
      }
      var f = document.createElement('iframe');
      f.className = 'kolong-dialog-iframe';
      f.title = dlg.getAttribute('aria-label') || 'Kolong Run';
      f.src = dlg.getAttribute('data-src');
      var settled = false;
      var timer = setTimeout(function () {
        if (!settled) f.remove();
      }, 5000);
      f.addEventListener('load', function () {
        if (settled) return;
        settled = true;
        clearTimeout(timer);
        frame = f;
        document.documentElement.classList.add('lightbox-open');
        dlg.showModal();
        try {
          f.contentWindow.focus();
        } catch (err) {
          // focus is best effort
        }
      });
      // A closed dialog is display:none; the frame still loads there.
      holder.appendChild(f);
    }

    function schedule() {
      var idle = window.requestIdleCallback || function (cb) { return setTimeout(cb, 1); };
      idle(function () {
        setTimeout(open, 2000);
      });
    }
    if (document.readyState === 'complete') schedule();
    else window.addEventListener('load', schedule, { once: true });
  })();
</script>
