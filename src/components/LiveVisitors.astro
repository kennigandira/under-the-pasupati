---
// Visitor numbers from the App-UTP check-ins (Supabase `public_stats`, see that
// repo's TRD section 7a). The site stays static: the browser fetches the
// aggregates. Without the two PUBLIC_ env vars nothing renders.
import type { Lang } from "../i18n/ui";

interface Props {
    lang: Lang;
    // compact: the two numbers only. full: numbers plus the 7-day graph.
    variant?: "compact" | "full";
}
const { lang, variant = "compact" } = Astro.props;
const url = import.meta.env.PUBLIC_SUPABASE_URL;
const key = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;
const enabled = Boolean(url && key);
const id = lang === "id";
---

{
    enabled && (
        <div
            class="live-visitors"
            data-url={url}
            data-key={key}
            data-lang={lang}
            hidden
        >
            <div class="stats live-visitors-stats">
                <div class="stat">
                    <div class="num">
                        <span data-now>–</span>
                        <span class="unit">{id ? "orang" : "people"}</span>
                    </div>
                    <div class="mono">
                        <span class="heartbeat" data-heartbeat aria-hidden="true"></span>
                        {id ? "di taman sekarang" : "at the park now"}
                    </div>
                </div>
                <div class="stat">
                    <div class="num" data-week>–</div>
                    <div class="mono">
                        {id ? "check-in minggu ini" : "check-ins this week"}
                    </div>
                </div>
            </div>
            {variant === "full" && (
                <figure class="live-graph">
                    <div
                        data-graph
                        class="live-bars"
                        role="list"
                        aria-label={
                            id
                                ? "Pengunjung unik per 4 jam, 7 hari terakhir"
                                : "Unique visitors per 4 hours, last 7 days"
                        }
                    ></div>
                    <figcaption class="mono">
                        {id
                            ? "Pengunjung unik per 4 jam, 7 hari terakhir"
                            : "Unique visitors per 4 hours, last 7 days"}
                        <span data-asof />
                    </figcaption>
                </figure>
            )}
        </div>
    )
}

<style>
    .live-visitors-stats {
        grid-template-columns: repeat(2, 1fr);
        margin-bottom: 1rem;
    }
    .live-graph {
        margin: 0;
    }
    /* "orang" beside the big number: smaller, plain, no outline. */
    .num .unit {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--ink);
        -webkit-text-stroke: 0;
        margin-left: 0.2rem;
    }
    /* Heartbeat: a green dot with a ring that pulses out while someone is checked in.
       With nobody there it is a still, dim dot. */
    .heartbeat {
        position: relative;
        display: inline-block;
        width: 0.7rem;
        height: 0.7rem;
        margin-right: 0.45rem;
        border-radius: 50%;
        background: var(--muted);
        border: 2px solid var(--ink);
        vertical-align: -0.1rem;
    }
    .heartbeat.is-live {
        background: var(--green);
    }
    .heartbeat.is-live::after {
        content: "";
        position: absolute;
        inset: -2px;
        border-radius: 50%;
        border: 2px solid var(--green);
        animation: heartbeat 1.4s ease-out infinite;
    }
    @keyframes heartbeat {
        0% {
            transform: scale(1);
            opacity: 0.9;
        }
        70%,
        100% {
            transform: scale(2.6);
            opacity: 0;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .heartbeat.is-live::after {
            animation: none;
            opacity: 0.35;
            transform: scale(1.8);
        }
    }
    /* One column per 4-hour window: bar on top, then date, time and head count below.
       Wide enough for the text, so the strip scrolls sideways (newest on the right). */
    .live-bars {
        display: flex;
        align-items: flex-end;
        gap: 0.35rem;
        overflow-x: auto;
        padding: 0.8rem 0.8rem 0.6rem;
        background: var(--white);
        border: var(--border);
        scroll-snap-type: x proximity;
    }
    .live-bars :global(.col) {
        flex: 0 0 4.6rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        scroll-snap-align: end;
    }
    .live-bars :global(.bar-wrap) {
        width: 100%;
        height: 7rem;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        border-bottom: 2px solid var(--ink);
    }
    .live-bars :global(.bar) {
        width: 70%;
        background: var(--accent);
        border: 2px solid var(--ink);
        border-bottom: 0;
        min-height: 3px;
    }
    .live-bars :global(.bar.is-zero) {
        visibility: hidden;
    }
    .live-bars :global(.d),
    .live-bars :global(.t),
    .live-bars :global(.n) {
        font-family: var(--font-mono);
        line-height: 1.25;
    }
    .live-bars :global(.d) {
        margin-top: 0.4rem;
        font-size: 0.72rem;
        font-weight: 700;
    }
    .live-bars :global(.t) {
        font-size: 0.66rem;
        color: var(--muted);
    }
    .live-bars :global(.n) {
        margin-top: 0.15rem;
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--accent);
    }
    .live-graph figcaption {
        margin-top: 0.4rem;
    }
</style>

<script>
    const POLL_MS = 30_000;

    document
        .querySelectorAll<HTMLElement>(".live-visitors")
        .forEach((root) => {
            const { url, key, lang } = root.dataset;
            const now = root.querySelector<HTMLElement>("[data-now]")!;
            const week = root.querySelector<HTMLElement>("[data-week]")!;
            const beat = root.querySelector<HTMLElement>("[data-heartbeat]");
            const graph = root.querySelector<HTMLElement>("[data-graph]");
            const asOf = root.querySelector<HTMLElement>("[data-asof]");

            const fetchStats = async () => {
                const res = await fetch(`${url}/rest/v1/rpc/public_stats`, {
                    method: "POST",
                    headers: {
                        apikey: key!,
                        Authorization: `Bearer ${key}`,
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({ p_slug: "pasupati", p_days: 7 }),
                });
                if (!res.ok) throw new Error(String(res.status));
                return (await res.json()) as {
                    now_present: number;
                    as_of: string | null;
                    series: { start: string; end: string; visitors: number; checkins: number }[];
                } | null;
            };

            let placed = false;
            type Point = { start: string; end: string; visitors: number };
            const draw = (series: Point[]) => {
                if (!graph) return;
                const idLang = lang === "id";
                const locale = idLang ? "id-ID" : "en-GB";
                const day = new Intl.DateTimeFormat(locale, {
                    day: "numeric",
                    month: "short",
                    timeZone: "Asia/Jakarta",
                });
                const hour = new Intl.DateTimeFormat("en-GB", {
                    hour: "2-digit",
                    hourCycle: "h23",
                    timeZone: "Asia/Jakarta",
                });
                const hh = (iso: string) => hour.format(new Date(iso)) + ".00";
                const unit = idLang ? "orang" : "people";
                const max = Math.max(1, ...series.map((p) => p.visitors));
                const wasAtEnd =
                    graph.scrollLeft + graph.clientWidth >= graph.scrollWidth - 8;
                graph.innerHTML = series
                    .map((p) => {
                        const h = Math.round((p.visitors / max) * 100);
                        const date = day.format(new Date(p.start));
                        const time = hh(p.start) + "–" + hh(p.end);
                        return `<div class="col" role="listitem" aria-label="${date}, ${time} WIB: ${p.visitors} ${unit}"><div class="bar-wrap"><div class="bar${p.visitors === 0 ? " is-zero" : ""}" style="height:${h}%"></div></div><span class="d">${date}</span><span class="t">${time}</span><span class="n">${p.visitors} ${unit}</span></div>`;
                    })
                    .join("");
                // Follow the newest window if the reader was already there; otherwise keep their place.
                if (placed && wasAtEnd) graph.scrollLeft = graph.scrollWidth;
            };

            const refresh = async () => {
                try {
                    const d = await fetchStats();
                    if (!d) return;
                    now.textContent = String(d.now_present);
                    beat?.classList.toggle("is-live", d.now_present > 0);
                    week.textContent = String(
                        d.series.reduce((n, s) => n + s.checkins, 0),
                    );
                    draw(d.series);
                    if (asOf && d.as_of) {
                        const t = new Intl.DateTimeFormat(
                            lang === "id" ? "id-ID" : "en-US",
                            {
                                dateStyle: "medium",
                                timeStyle: "short",
                                timeZone: "Asia/Jakarta",
                            },
                        ).format(new Date(d.as_of));
                        asOf.textContent = ` · ${lang === "id" ? "per" : "as of"} ${t} WIB`;
                    }
                    root.hidden = false;
                    // The block is display:none until now, so the first scroll to the newest window waits for layout.
                    if (graph && !placed) {
                        graph.scrollLeft = graph.scrollWidth;
                        placed = true;
                    }
                } catch {
                    // Stats are a bonus: on failure keep the last values (or stay hidden).
                }
            };

            void refresh();
            setInterval(() => {
                if (!document.hidden) void refresh();
            }, POLL_MS);
        });
</script>
