---
import { localeHref, t, type Lang, type UIKey } from '../i18n/ui';

// The Kolong Run shell: canvas stage, A/B buttons and (standalone only) the
// how-to-play text. The game itself lives in src/lib/game and boots from the
// script below on every [data-kolong] root.
interface Props {
  lang: Lang;
  embed?: boolean;
}
const { lang, embed = false } = Astro.props;

const stringKeys = [
  'title', 'tagline', 'start', 'book', 'bookTitle', 'back', 'best', 'score',
  'gameover', 'retry', 'closeGame', 'toTitle', 'paused', 'resume', 'quit',
  'crash', 'bail', 'clean', 'sketchy', 'newBest', 'hintHold', 'hintTap',
  'btnA', 'btnB', 'noCanvas',
] as const;
const strings = Object.fromEntries(
  stringKeys.map((k) => [k, t(lang, `game.${k}` as UIKey)]),
);
---

<div
  class:list={['kolong', embed && 'is-embed']}
  data-kolong
  data-embed={embed ? '1' : '0'}
  data-home={localeHref(lang, '')}
  data-strings={JSON.stringify(strings)}
>
  <div class="kolong-stage" data-stage tabindex="0" role="group" aria-label={t(lang, 'game.page.title')}>
    <canvas width="176" height="96" role="img" aria-label={t(lang, 'game.page.desc')}></canvas>
  </div>

  <div class="kolong-controls" data-controls>
    <button class="kbtn kbtn-a" type="button" data-btn="A" aria-label={`A: ${t(lang, 'game.btnA')}`}>
      <span aria-hidden="true">A</span>
    </button>
    <button class="kpause" type="button" data-pause hidden aria-label={t(lang, 'game.pause')}>
      <span aria-hidden="true">II</span>
    </button>
    <button class="kbtn kbtn-b" type="button" data-btn="B" aria-label={`B: ${t(lang, 'game.btnB')}`}>
      <span aria-hidden="true">B</span>
    </button>
  </div>

  {!embed && (
    <section class="kolong-help">
      <h2>{t(lang, 'game.help.title')}</h2>
      <ul>
        <li>{t(lang, 'game.help.keys')}</li>
        <li>{t(lang, 'game.help.touch')}</li>
        <li>{t(lang, 'game.help.jump')}</li>
        <li>{t(lang, 'game.help.tricks')}</li>
        <li>{t(lang, 'game.help.rides')}</li>
      </ul>
      <p><a href={localeHref(lang, '')}>{t(lang, 'game.home')}</a></p>
    </section>
  )}
</div>

<style is:global>
  body.kolong-page::after { display: none; }
  body.kolong-page { overscroll-behavior: none; }
  body.kolong-embed { background: var(--paper); overflow: hidden; }
</style>

<style>
  .kolong {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    width: 100%;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }
  .kolong.is-embed {
    position: fixed;
    inset: 0;
    height: 100dvh;
    justify-content: flex-start;
    background: var(--paper);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .kolong-stage {
    line-height: 0;
    outline: none;
    box-shadow: 0 0 0 3px var(--ink);
    touch-action: none;
  }
  canvas {
    display: block;
    image-rendering: crisp-edges;
    image-rendering: pixelated;
    touch-action: none;
  }

  .kolong-controls {
    display: none;
    width: 100%;
    max-width: 520px;
    padding: 0.25rem 1rem 1rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    touch-action: none;
  }
  @media (pointer: coarse), (max-width: 700px) {
    .kolong-controls { display: flex; }
  }
  :global(.has-touch) .kolong-controls { display: flex; }

  .kbtn {
    width: min(38vw, 168px);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 4px solid var(--ink);
    font-family: var(--font-logo);
    font-size: 3.2rem;
    line-height: 1;
    color: var(--white);
    box-shadow: 0 6px 0 var(--ink);
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
    cursor: pointer;
  }
  .kbtn-a { background: var(--accent); }
  .kbtn-b { background: var(--blue); }
  .kbtn[data-pressed] {
    transform: translateY(5px);
    box-shadow: 0 1px 0 var(--ink);
  }
  .kbtn:focus-visible, .kpause:focus-visible { outline: 3px solid var(--pink); outline-offset: 3px; }

  .kpause {
    width: 3rem;
    height: 3rem;
    border-radius: 0.5rem;
    border: 3px solid var(--ink);
    background: var(--tape);
    font-family: var(--font-logo);
    font-size: 1rem;
    touch-action: manipulation;
    cursor: pointer;
  }
  .kpause[hidden] { display: none; }

  /* Phones held sideways: buttons float over the sides instead of eating height. */
  @media (pointer: coarse) and (orientation: landscape) and (max-height: 520px) {
    .kolong-controls {
      position: absolute;
      inset: auto 0 0.5rem 0;
      max-width: none;
      padding: 0 1rem;
      pointer-events: none;
    }
    .kbtn { width: 96px; font-size: 2.4rem; pointer-events: auto; }
    .kpause { pointer-events: auto; }
  }

  .kolong-help { max-width: 640px; width: 100%; padding: 0 0.75rem; }
  .kolong-help h2 { margin-bottom: 0.5rem; }
  .kolong-help ul { padding-left: 1.2rem; display: grid; gap: 0.4rem; margin-bottom: 1rem; }
</style>

<script>
  import { boot } from '../lib/game/main.ts';
  boot();
</script>
