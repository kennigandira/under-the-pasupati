---
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/ui';
import { specialtyVideos, type SpecialtyKey } from '../data/content';

// A coach's discipline, linked to its reference clip. Falls back to plain text
// when the discipline has no clip configured.
interface Props {
  lang: Lang;
  label: Record<Lang, string>;
  videoKey?: SpecialtyKey;
}
const { lang, label, videoKey } = Astro.props;
const video = videoKey ? specialtyVideos[videoKey] : undefined;
---

{video ? (
  <button
    class="specialty-link"
    type="button"
    data-specialty-video={video.id}
    data-specialty-vertical={video.vertical ? '1' : undefined}
    data-specialty-blurb={video.blurb[lang]}
    aria-label={`${label[lang]} — ${t(lang, 'coach.specialty.video')}`}
  >
    {label[lang]} <span aria-hidden="true">▶</span>
  </button>
) : (
  label[lang]
)}
