# Indonesian now lives at the root (/about/), English keeps its prefix
# (/en/about/). Old /id/... links were shared widely, so fold them onto root.
# /id/ is listed before the wildcard so the empty-splat case never relies on
# Cloudflare collapsing /:splat to nothing.
/id/ / 301
/id / 301
/id/* /:splat 301

/communities/ /partners/ 301
/communities /partners/ 301
/en/communities/ /en/partners/ 301
/en/communities /en/partners/ 301

# Hall of Fame is now Skater of the Month (SOTM).
/hall-of-fame/* /skater-of-the-month/:splat 301
/hall-of-fame /skater-of-the-month/ 301
/en/hall-of-fame/* /en/skater-of-the-month/:splat 301
/en/hall-of-fame /en/skater-of-the-month/ 301
